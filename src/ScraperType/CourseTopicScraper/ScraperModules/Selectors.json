{
  "CourseTopicScraper" : {
    "courseType" : "cloudLab",
    "courseHeader" : {
      "cloudLab" : "span[class*=body-medium]",
      "project": "span[class*=body-medium]"
    },
    "topicHeader" : {
      "cloudLab" : "p[class*='text-3xl']",
      "project": "span[class*=body-medium]"
    },
    "sideBarTopics": {
      "cloudLab" : "div[data-testid*='progress-bar-svg']",
      "project": "div[data-testid*='progress-bar-svg']"
    },
    "highlightedTopic": {
      "cloudLab" : "bg-gray-L200 dark:bg-gray-D1200",
      "project": "bg-gray-L200 dark:bg-gray-D1200"
    }
  },
  "SeleniumBasicUtility": {
    "cloudLabPage": "div[id*='viewer-component']",
    "articlePage": "(//div[@id='handleArticleScroll']//div[count(div)>=3])[1]",
    "generalPage": "(//div[@id='view-collection-article-content-root']//div[count(div)>=3])[1]",
    "nextButton": "Next",
    "backButton": "Back",
    "expandAllButton": "//button[contains(., 'Expand All Sections')]",
    "resizeHorizontalGlutter": "div[style*='30%'][style*='calc']"
  },
  "RemoveUtility": {
    "articleFooter": "(//div[@id='handleArticleScroll']//div[count(div)>=3])[1]/div[3]",
    "markAsCompleted": "//span[normalize-space() = 'Mark As Completed']",
    "completed": "//span[normalize-space() = 'Completed']",
    "navNode": "div[class*='ed-grid'] > nav",
    "privacyNode": "div[aria-label*='Your Privacy']",
    "askQuestionDarkModeToolbar": "div[id*='view-collection-article-content-root'] > :not(#handleArticleScroll):not(:last-child), div[id*='view-collection-article-content-root']:not(:has(#handleArticleScroll)) > :not(:last-child)",
    "streakNode": "div[aria-labelledby*='simple-modal-title']",
    "bodyChildNodes": "body > *",
    "headChildNodes": "head > *",
    "sidebar": "div[aria-label*='toggle sidebar']",
    "fixed": "div[class*='fixed']",
    "vscodeProjectWindow": "div[class*='gutter gutter-horizontal'] + div"
  },
  "ShowUtility": {
    "showMarkDownQuizSolution": "Show Answer",
    "showCodeSolution": "Show",
    "confirmShowSolution": "button[aria-label*='confirm']",
    "showHints": "g[id*='noun_lightbulb']",
    "showSlides": "svg[aria-label*='view all slides']"
  },
  "SingleFileUtility": {
    "objectTag": "object[role='img']",
    "codeContainerClass": "monaco-editor"
  },
  "ScreenshotHtmlUtility": {
    "rootContent": "//*[@id='view-collection-article-content-root']"
  },
  "ApiUtility": {
    "nextData": "script[id*='__NEXT_DATA__']",
    "pathSelector": "//a[contains(@href, '/path/')]/../..//p[contains(text(), 'Module')]/a"
  }
}